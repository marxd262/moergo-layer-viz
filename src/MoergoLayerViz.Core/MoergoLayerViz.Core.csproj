<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MoergoLayerViz.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MoergoLayerViz.Tests" />
    <!-- WindowsBleRawHidLayerSource (App, Windows-only) parses raw HID reports
         via Core's internal RawHidProtocol. Mac/USB sources live inside Core
         so they don't need this; only the WinRT BLE source crosses assemblies. -->
    <InternalsVisibleTo Include="MoergoLayerViz.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
  </ItemGroup>

</Project>
