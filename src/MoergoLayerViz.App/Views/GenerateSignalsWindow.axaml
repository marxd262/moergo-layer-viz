<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MoergoLayerViz.App.ViewModels"
        x:Class="MoergoLayerViz.App.Views.GenerateSignalsWindow"
        x:DataType="vm:GenerateSignalsViewModel"
        Title="{Binding [Title_GenerateSignals], Source={StaticResource Loc}}"
        Width="560" Height="720"
        MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" Spacing="14">

            <!-- Header -->
            <TextBlock Text="{Binding [Generate_Heading], Source={StaticResource Loc}}"
                       FontSize="16" FontWeight="SemiBold" Foreground="#CDD6F4" />
            <TextBlock Text="{Binding [Generate_Description], Source={StaticResource Loc}}"
                       Foreground="#A6ADC8" FontSize="12" TextWrapping="Wrap" />

            <Border Height="1" Background="#313244" />

            <!-- Loaded layout indicator -->
            <StackPanel Spacing="4">
                <TextBlock Text="{Binding [Generate_LoadedLayout], Source={StaticResource Loc}}"
                           FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4" />
                <TextBlock Text="{Binding LoadedLayoutDisplay}"
                           Foreground="#A6E3A1" FontSize="12" />
            </StackPanel>

            <!-- Layer selection -->
            <StackPanel Spacing="6" IsVisible="{Binding Layers.Count}">
                <TextBlock Text="{Binding [Generate_LayersHeading], Source={StaticResource Loc}}"
                           FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4" />
                <TextBlock Text="{Binding [Generate_LayersHint], Source={StaticResource Loc}}"
                           Foreground="#6C7086" FontSize="11" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="{Binding [Generate_SelectAll], Source={StaticResource Loc}}"
                            Command="{Binding SelectAllCommand}"
                            Padding="10,3" FontSize="11" />
                    <Button Content="{Binding [Generate_ClearAll], Source={StaticResource Loc}}"
                            Command="{Binding ClearSelectionCommand}"
                            Padding="10,3" FontSize="11" />
                </StackPanel>
                <Border BorderBrush="#313244" BorderThickness="1" CornerRadius="4"
                        Background="#181825">
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Layers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,3">
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Label}"
                                                   Foreground="#CDD6F4" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Margin="6,0,0,0" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding ProjectedFkey}"
                                                   Foreground="#94E2D5" FontSize="11"
                                                   FontFamily="Consolas, Menlo, monospace"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <!-- Start Fkey -->
            <StackPanel Spacing="6">
                <TextBlock Text="{Binding [Generate_StartFkey], Source={StaticResource Loc}}"
                           FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4" />
                <TextBlock Text="{Binding [Generate_StartFkeyHint], Source={StaticResource Loc}}"
                           Foreground="#6C7086" FontSize="11" TextWrapping="Wrap" />
                <NumericUpDown Value="{Binding StartFkey, Mode=TwoWay}"
                               Minimum="{Binding MinFkey}"
                               Maximum="{Binding MaxFkey}"
                               Increment="1"
                               FormatString="0"
                               Width="120"
                               HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Action -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{Binding [Generate_Button], Source={StaticResource Loc}}"
                        Command="{Binding GenerateCommand}"
                        IsEnabled="{Binding !IsBusy}"
                        Padding="14,6"
                        Background="#89B4FA"
                        Foreground="#1E1E2E"
                        FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           Foreground="#F9E2AF"
                           TextWrapping="Wrap" />
            </StackPanel>

            <!-- Results panel — only after a successful generation -->
            <Border IsVisible="{Binding HasResult}"
                    Background="#181825"
                    BorderBrush="#313244" BorderThickness="1"
                    CornerRadius="6"
                    Padding="14">
                <StackPanel Spacing="12">

                    <TextBlock Text="{Binding [Generate_ResultsHeading], Source={StaticResource Loc}}"
                               FontSize="13" FontWeight="SemiBold" Foreground="#CDD6F4" />

                    <!-- Added -->
                    <StackPanel Spacing="4" IsVisible="{Binding AddedItems.Count}">
                        <TextBlock Text="{Binding [Generate_Added], Source={StaticResource Loc}}"
                                   FontWeight="SemiBold" Foreground="#A6E3A1" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding AddedItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#CDD6F4" FontSize="11"
                                               FontFamily="Consolas, Menlo, monospace" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Skipped -->
                    <StackPanel Spacing="4" IsVisible="{Binding SkippedItems.Count}">
                        <TextBlock Text="{Binding [Generate_Skipped], Source={StaticResource Loc}}"
                                   FontWeight="SemiBold" Foreground="#94E2D5" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding SkippedItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#A6ADC8" FontSize="11"
                                               FontFamily="Consolas, Menlo, monospace" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Warnings -->
                    <StackPanel Spacing="4" IsVisible="{Binding Warnings.Count}">
                        <TextBlock Text="{Binding [Generate_Warnings], Source={StaticResource Loc}}"
                                   FontWeight="SemiBold" Foreground="#F38BA8" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding Warnings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#F9E2AF" FontSize="11"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <Border Height="1" Background="#313244" />

                    <!-- Next-steps instructions -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding [Generate_NextSteps], Source={StaticResource Loc}}"
                                   FontWeight="SemiBold" Foreground="#CDD6F4" FontSize="12" />
                        <TextBlock Text="{Binding [Generate_NextStepsBody], Source={StaticResource Loc}}"
                                   Foreground="#A6ADC8" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Window>
