<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoergoLayerViz.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:convApp="using:MoergoLayerViz.App.Converters"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="MoergoLayerViz.App.Views.BoardView"
             x:Name="Board"
             x:DataType="vm:IBoardSurface">

    <UserControl.Resources>
        <!-- All brushes (KeyStroke, ComboFill, ComboStroke) live in App.axaml
             — keep this dictionary template-only. -->

        <!-- Single key template, shared between the two per-hand ItemsControls
             below so we don't have to keep two copies in sync. -->
        <DataTemplate x:Key="KeyTemplate" x:DataType="vm:KeyViewModel">
            <Grid Width="{Binding Position.Width}"
                  Height="{Binding Position.Height}"
                  Background="Transparent"
                  PointerPressed="OnKeyPointerPressed"
                  RenderTransformOrigin="{Binding RotationOrigin}"
                  ToolTip.Tip="{Binding Tooltip}">
                <Grid.RenderTransform>
                    <RotateTransform Angle="{Binding Position.RotationDegrees}" />
                </Grid.RenderTransform>

                <!-- Inner Margin gives every key a uniform visual gap from
                     its neighbours without disturbing the outer Grid's
                     hit-test rectangle or its absolute-coord rotation
                     pivot. Tune here to adjust all dtsi-rendered boards
                     at once. -->
                <Grid Margin="1">
                <!-- Key fill: driven by KeyFillColor (precedence: decoration.background
                     > target-layer palette color > default KeyDefaultFill). -->
                <Rectangle RadiusX="6" RadiusY="6"
                           Stroke="{StaticResource KeyStroke}"
                           StrokeThickness="1"
                           Fill="{Binding KeyFillColor, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}" />

                <!-- Press-indicator dot: pulses when the hook sees this
                     key fire. Fill/Stroke walk past the per-item
                     KeyViewModel DataContext via ElementName=Board to
                     pick up the user-chosen highlight color from the
                     MainWindowViewModel that owns this UserControl. -->
                <Ellipse Classes="pressDot"
                         Classes.active="{Binding IsAnyHighlight}"
                         Width="10" Height="10"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,5,5,0"
                         IsHitTestVisible="False"
                         Fill="{Binding DataContext.BoardStyle.PressHighlightColor, ElementName=Board, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}"
                         Stroke="{Binding DataContext.BoardStyle.PressHighlightStrokeColor, ElementName=Board, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}"
                         StrokeThickness="1" />

                <!-- Combo-indicator earmark: right triangle hugging the
                     bottom-left corner. Shown only when the combo overlay
                     is OFF — when it's ON, the numbered badge ItemsControl
                     below replaces the earmark. The combo's name, key
                     positions, and resulting binding are appended to the
                     per-key tooltip in either mode. -->
                <Path Data="M 0,0 L 0,8 A 6,6 0 0 0 6,14 L 14,14 Z"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Bottom"
                      IsHitTestVisible="False"
                      Fill="{StaticResource ComboFill}"
                      Stroke="{StaticResource ComboStroke}"
                      StrokeThickness="1">
                    <Path.IsVisible>
                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                            <Binding Path="IsInCombo" />
                            <Binding Path="DataContext.IsComboOverlayVisible"
                                     ElementName="Board"
                                     Converter="{x:Static conv:BoolConverters.Not}" />
                        </MultiBinding>
                    </Path.IsVisible>
                </Path>

                <!-- Numbered combo badges: shown when the combo overlay is ON.
                     One pill per combo this key participates in, anchored at
                     the bottom-left and stacked horizontally. Capped at 3 in
                     the VM (KeyComboBadgeViewModel.MaxBadgesPerKey) — extra
                     numbers stay in the tooltip. Each pill's PointerEntered
                     calls SetHighlightedCombos so the matching legend tile
                     lights up. -->
                <ItemsControl ItemsSource="{Binding ComboBadges}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Bottom"
                              Margin="2,0,0,2">
                    <ItemsControl.IsVisible>
                        <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                            <Binding Path="IsInCombo" />
                            <Binding Path="DataContext.IsComboOverlayVisible" ElementName="Board" />
                        </MultiBinding>
                    </ItemsControl.IsVisible>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:KeyComboBadgeViewModel">
                            <Border Classes="comboBadge"
                                    Classes.active="{Binding IsHighlighted}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    Padding="3,0"
                                    PointerEntered="OnComboBadgePointerEntered"
                                    PointerExited="OnComboBadgePointerExited">
                                <TextBlock Text="{Binding Number}"
                                           FontSize="8"
                                           FontWeight="Bold"
                                           IsHitTestVisible="False" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Category hint in the top-left corner (e.g. "To Layer",
                     "Layer Tap") — distinguishes layer-switch keys at a
                     glance without cluttering the main glyph. -->
                <TextBlock Text="{Binding TopLeftLabel}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="4,5,0,0"
                           FontSize="7"
                           FontWeight="Bold"
                           Opacity="0.75"
                           FontStyle="Italic"
                           Foreground="{Binding KeyForegroundColor, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}"
                           IsVisible="{Binding TopLeftLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                <!-- Label stack: optional Font Awesome icon on top (from
                     decoration.icon), then main glyph, then optional
                     subscript. Dark foreground works across default
                     white and the pastel layer palette. -->
                <StackPanel Orientation="Vertical"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,8,0,0"
                            Spacing="2">
                    <i:Icon Value="{Binding IconName}"
                            FontSize="14"
                            Opacity="0.8"
                            HorizontalAlignment="Center"
                            Foreground="{Binding KeyForegroundColor, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}"
                            IsVisible="{Binding IconName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding Label}"
                               HorizontalAlignment="Center"
                               FontSize="{Binding LabelFontSize}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{Binding KeyForegroundColor, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}" />
                    <TextBlock Text="{Binding Subscript}"
                               HorizontalAlignment="Center"
                               FontSize="{Binding SubscriptFontSize}"
                               FontWeight="Bold"
                               Opacity="0.9"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Foreground="{Binding KeyForegroundColor, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}"
                               IsVisible="{Binding Subscript, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- Shared key-cap styles, applied to both per-hand ItemsControls below.
         These are class-selector styles (no per-item Binding), so they hoist
         safely here instead of being duplicated inside each ItemsControl.Styles.
         Background / BorderBrush / Foreground live on Style setters (not inline)
         because local attribute values beat Style setters in Avalonia — leaving
         them inline would shadow the .active swap and break the legend → pill
         highlight direction. -->
    <UserControl.Styles>
        <Style Selector="Ellipse.pressDot">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Ellipse.pressDot.active">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.comboBadge">
            <Setter Property="Background" Value="{StaticResource ComboFill}" />
            <Setter Property="BorderBrush" Value="{StaticResource ComboStroke}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.comboBadge TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BgBase}" />
        </Style>
        <Style Selector="Border.comboBadge.active">
            <Setter Property="Background" Value="{StaticResource ComboStroke}" />
        </Style>
        <Style Selector="Border.comboBadge.active TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
        </Style>
    </UserControl.Styles>

    <!-- Viewbox auto-scales the fixed canvas to whatever room the window
         provides. Outer Canvas hosts two per-hand groups: each
         ItemsControl renders its keys at their absolute Position.X/Y, but
         the surrounding Canvas.Left/Top on the host ItemsControl shifts
         the whole half. In horizontal mode all four offsets are 0; in
         stacked mode the halves are translated to sit one above the other.
         NOTE: Canvas.Left/Top are applied via ItemsControl.Styles (per-item
         Binding context) rather than ItemContainerTheme — the ControlTheme
         variant doesn't rebind reliably per item in Avalonia 11, which
         collapses every key to (0,0). -->
    <Viewbox Stretch="Uniform" StretchDirection="Both" ClipToBounds="False">
        <Canvas Width="{Binding BoardLayout.CanvasWidth}" Height="{Binding BoardLayout.CanvasHeight}"
                Background="Transparent" ClipToBounds="False">
            <ItemsControl ItemsSource="{Binding LeftKeys}"
                          Width="{Binding BoardLayout.BoardSurfaceWidth}"
                          Height="{Binding BoardLayout.BoardSurfaceHeight}"
                          Canvas.Left="{Binding BoardLayout.LeftHandX}"
                          Canvas.Top="{Binding BoardLayout.LeftHandY}"
                          ClipToBounds="False"
                          ItemTemplate="{StaticResource KeyTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <!-- Per-item Canvas positioning stays scoped per ItemsControl
                     (the ContentPresenter selector + per-item {Binding} setters
                     are the proven pattern; see CLAUDE.md). The press-dot and
                     combo-badge class styles are shared in UserControl.Styles. -->
                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Position.X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Position.Y}" />
                    </Style>
                </ItemsControl.Styles>
            </ItemsControl>

            <ItemsControl ItemsSource="{Binding RightKeys}"
                          Width="{Binding BoardLayout.BoardSurfaceWidth}"
                          Height="{Binding BoardLayout.BoardSurfaceHeight}"
                          Canvas.Left="{Binding BoardLayout.RightHandX}"
                          Canvas.Top="{Binding BoardLayout.RightHandY}"
                          ClipToBounds="False"
                          ItemTemplate="{StaticResource KeyTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter">
                        <Setter Property="Canvas.Left" Value="{Binding Position.X}" />
                        <Setter Property="Canvas.Top" Value="{Binding Position.Y}" />
                    </Style>
                </ItemsControl.Styles>
            </ItemsControl>
        </Canvas>
    </Viewbox>

</UserControl>
