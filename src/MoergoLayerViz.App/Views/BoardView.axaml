<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoergoLayerViz.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:convApp="using:MoergoLayerViz.App.Converters"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="MoergoLayerViz.App.Views.BoardView"
             x:Name="Board"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Resources>
        <!-- Palette tuned to the earlier xaml.io sketch. -->
        <SolidColorBrush x:Key="KeyFill" Color="#F2F2F2" />
        <SolidColorBrush x:Key="KeyStroke" Color="#B0B0B0" />
        <SolidColorBrush x:Key="LayerKeyFill" Color="#1F8B4C" />
        <SolidColorBrush x:Key="UntrackableKeyFill" Color="#E64980" />
        <SolidColorBrush x:Key="PressHighlight" Color="#FFD60A" />
        <SolidColorBrush x:Key="KeyLabel" Color="#1E1E2E" />
        <SolidColorBrush x:Key="LayerKeyLabel" Color="#F2F2F2" />
    </UserControl.Resources>

    <!-- Viewbox auto-scales the fixed 1400×600 board to whatever room the
         window provides. We keep aspect so rotated thumb keys read correctly.
         NOTE: Canvas.Left/Top are applied via ItemsControl.Styles (per-item
         Binding context) rather than ItemContainerTheme — the ControlTheme
         variant doesn't rebind reliably per item in Avalonia 11, which
         collapses every key to (0,0). -->
    <Viewbox Stretch="Uniform" StretchDirection="Both">
        <ItemsControl ItemsSource="{Binding Keys}"
                      Width="{Binding CanvasWidth}"
                      Height="{Binding CanvasHeight}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Styles>
                <Style Selector="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding Position.X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Position.Y}" />
                </Style>
                <!-- Press-indicator dot: a small saturated circle in the top-right
                     corner pops on for a beat when the hook sees this key fire. -->
                <Style Selector="Ellipse.pressDot">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.08" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Ellipse.pressDot.active">
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KeyViewModel">
                    <Grid Width="{Binding Position.Width}"
                          Height="{Binding Position.Height}"
                          ToolTip.Tip="{Binding Tooltip}">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="{Binding Position.RotationDegrees}" />
                        </Grid.RenderTransform>
                        <Grid.RenderTransformOrigin>0.5,0.5</Grid.RenderTransformOrigin>

                        <!-- Key fill: driven by KeyFillColor (precedence: decoration.background
                             > target-layer palette color > default #F2F2F2). -->
                        <Rectangle RadiusX="6" RadiusY="6"
                                   Stroke="{StaticResource KeyStroke}"
                                   StrokeThickness="1"
                                   Fill="{Binding KeyFillColor, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}" />

                        <!-- Press-indicator dot: saturated-yellow circle in the
                             top-right corner, pulses when the hook sees this
                             key fire. Color inlined (not StaticResource) because
                             resource lookup into a DataTemplate scope is
                             unreliable. -->
                        <Ellipse Classes="pressDot"
                                 Classes.active="{Binding IsPressed}"
                                 Width="10" Height="10"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,5,5,0"
                                 IsHitTestVisible="False"
                                 Fill="#FFD60A"
                                 Stroke="#8A6D00"
                                 StrokeThickness="1" />

                        <!-- Untrackable-layer warning: pink border over the base fill -->
                        <Rectangle RadiusX="6" RadiusY="6"
                                   Stroke="{StaticResource UntrackableKeyFill}"
                                   StrokeThickness="2"
                                   Fill="Transparent"
                                   IsVisible="{Binding IsUntrackableLayerSwitch}" />

                        <!-- Category hint in the top-left corner (e.g. "To Layer",
                             "Layer Tap") — distinguishes layer-switch keys at a
                             glance without cluttering the main glyph. -->
                        <TextBlock Text="{Binding TopLeftLabel}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Margin="4,5,0,0"
                                   FontSize="7"
                                   FontWeight="Bold"
                                   Opacity="0.75"
                                   FontStyle="Italic"
                                   Foreground="{Binding KeyForegroundColor, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}"
                                   IsVisible="{Binding TopLeftLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Label stack: optional Font Awesome icon on top (from
                             decoration.icon), then main glyph, then optional
                             subscript. Dark foreground works across default
                             white and the pastel layer palette. -->
                        <StackPanel Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="0,8,0,0"
                                    Spacing="2">
                            <i:Icon Value="{Binding IconName}"
                                    FontSize="14"
                                    Opacity="0.8"
                                    HorizontalAlignment="Center"
                                    Foreground="{Binding KeyForegroundColor, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}"
                                    IsVisible="{Binding IconName, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{Binding Label}"
                                       HorizontalAlignment="Center"
                                       FontSize="{Binding LabelFontSize}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Foreground="{Binding KeyForegroundColor, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}" />
                            <TextBlock Text="{Binding Subscript}"
                                       HorizontalAlignment="Center"
                                       FontSize="{Binding SubscriptFontSize}"
                                       FontWeight="Bold"
                                       Opacity="0.9"
                                       TextAlignment="Center"
                                       Foreground="{Binding KeyForegroundColor, Converter={x:Static convApp:HexColorToBrushConverter.Instance}}"
                                       IsVisible="{Binding Subscript, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Viewbox>

</UserControl>
